DEDUP_TTL_SECONDS=86400

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_NAME=web3_alpha
TELEGRAM_SOURCE=api
TELEGRAM_FETCH_LIMIT=100
TELEGRAM_POLL_INTERVAL_SECONDS=60
TELEGRAM_SESSION_STRING=your_telethon_string_session
TELEGRAM_CHANNELS=@channel_a,@group_b

PUBLIC_TELEGRAM_CHANNELS=@channel_a,@group_b
PUBLIC_POLL_INTERVAL_SECONDS=60
PUBLIC_FETCH_LIMIT=20

DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
DISCORD_ENABLED=false
DISCORD_MODE=session
DISCORD_POLL_INTERVAL_SECONDS=60
DISCORD_REQUEST_TIMEOUT_SECONDS=15
DISCORD_SESSION_TOKEN=
DISCORD_USER_AGENT=

X_FEED_ENABLED=false
